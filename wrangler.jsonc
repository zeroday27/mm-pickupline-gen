{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mm-pickupline-gen",
  "main": "worker/index.js",
  "compatibility_date": "2026-04-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "containers": [
    { "class_name": "PickupApi", "image": "./Dockerfile.backend", "max_instances": 1 }
  ],
  "durable_objects": { "bindings": [{ "name": "API", "class_name": "PickupApi" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PickupApi"] }]
}

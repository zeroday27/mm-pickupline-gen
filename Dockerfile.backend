FROM node:24-alpine AS tools
WORKDIR /app/backend
COPY backend/package*.json ./
RUN npm ci --omit=dev
COPY backend/src ./src/
FROM tools AS api_runtime
# The running API only needs Node. Keep package managers in the tools stage.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
USER node
EXPOSE 3000
CMD ["node", "src/index.js"]

FROM node:24-alpine AS web_build
WORKDIR /web
COPY package*.json ./
RUN npm ci
COPY index.html vite.config.js postcss.config.cjs tailwind.config.cjs ./
COPY public ./public
COPY src ./src
RUN VITE_API_URL=/api npm run build

FROM api_runtime AS cloud_run
COPY --from=web_build /web/dist /app/site
ENV SITE_DIR=/app/site NODE_ENV=production

FROM api_runtime AS runtime
